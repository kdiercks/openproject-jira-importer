# Jira Configuration
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Xray Cloud Configuration (optional, required for test step and execution migration)
# Create API keys in Xray: Settings > API Keys
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret
# Optional, for Xray Cloud regions or a custom Xray endpoint
# XRAY_BASE_URL=https://xray.cloud.getxray.app/api/v2

# OpenProject Configuration
OPENPROJECT_HOST=https://your-openproject-instance.com
OPENPROJECT_API_KEY=your-openproject-api-key 
# Custom Field Configuration
# The ID of the custom field in OpenProject that stores the Jira issue ID
# You can find this ID in OpenProject: Administration > Custom fields > Work packages
# Look for a text custom field that will store the Jira issue key
# Default: 1
JIRA_ID_CUSTOM_FIELD=1

# Test step custom field IDs in OpenProject (optional)
# OPENPROJECT_TEST_STEP_ACTION_FIELD=24
# OPENPROJECT_TEST_STEP_EXPECTED_FIELD=25
# OPENPROJECT_TEST_STEP_DATA_FIELD=26

# Relation type for Test Execution -> Test and Test Plan -> Test Execution links (optional)
# OPENPROJECT_TEST_RELATION_TYPE=includes
